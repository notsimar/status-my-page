# Status page configuration
# Each item in this list appears as a status card on the page.
# Edit the names here to match your infrastructure components, then restart the app.

items:
  - Slack
  - Glean
  - Google workspace
  - Peoplefinder
  - ServiceNow
  - MS365
  - Azure
  - Learning
  - Timekeeping
  - Workday
  - Confluence

# Admin credentials
# DO NOT store passwords here. Use environment variables exclusively:
#   STATUS_ADMIN_USER=admin
#   STATUS_ADMIN_PASS_HASH=<hash from werkzeug.security.generate_password_hash>
admin:
  user: admin

# Server settings
server:
  host: "0.0.0.0"
  port: 8920
  secret_key_env: STATUS_SECRET_KEY
